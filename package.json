{
  "name": "pageperch",
  "version": "0.1.7",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "audit:csp": "npm run audit:package && npm run audit:editor",
    "audit:editor": "node scripts/audit-editor.ts",
    "audit:package": "node scripts/audit-package.ts",
    "build": "npm run generate:icons && vite build && node scripts/verify-build.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run audit:csp && npm run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:icons": "node scripts/generate-icons.ts",
    "lint": "eslint . --max-warnings 0",
    "release:package": "npm run build && npm run audit:csp && node scripts/package-release.ts",
    "test": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@automattic/isolated-block-editor": "2.30.0",
    "@aws-sdk/client-s3": "3.1095.0",
    "@wordpress/api-fetch": "7.24.0",
    "@wordpress/block-editor": "14.19.0",
    "@wordpress/block-serialization-default-parser": "5.24.0",
    "@wordpress/blocks": "14.13.0",
    "@wordpress/commands": "1.24.0",
    "@wordpress/data": "10.24.0",
    "@wordpress/dataviews": "4.20.0",
    "@wordpress/patterns": "2.24.0",
    "@wordpress/preferences": "4.24.0",
    "@wordpress/rich-text": "7.24.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "overrides": {
    "@wordpress/commands": "1.24.0",
    "@wordpress/data": "10.24.0",
    "@wordpress/dataviews": "4.20.0",
    "@wordpress/patterns": "2.24.0",
    "@wordpress/preferences": "4.24.0",
    "@wordpress/core-data@7.24.0": {
      "@wordpress/sync": "1.24.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.2.2",
    "@types/node": "24.13.3",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "sass": "1.101.7",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
